{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Bank": {
    "BaseUrl": "http://localhost:5196/"
  },
  "FakeBank": {
    "TokenLifetimeSeconds": 120,
    "FailureRate": 0.05
  },
  "Erp": {
    "TimeoutRate": 0.05
  },
  "Jobs": {
    "Enabled": true,
    "SyncIntervalSeconds": 60,
    "ExportIntervalSeconds": 60
  }
}
